# `.env.example`

# ============================================================

# LLM PROVIDER

# ============================================================

# Available providers:

# gemini

# groq

# openrouter

# deepseek

LLM_PROVIDER=gemini

# ============================================================

# GEMINI

# ============================================================

# Required when LLM_PROVIDER=gemini

# GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.6-flash

# ============================================================

# GROQ

# ============================================================

# Required when LLM_PROVIDER=groq

# GROQ_API_KEY=

GROQ_MODEL=llama-3.3-70b-versatile

# ============================================================

# OPENROUTER

# ============================================================

# Required when LLM_PROVIDER=openrouter

# OPENROUTER_API_KEY=

OPENROUTER_MODEL=openrouter/free

# ============================================================

# DEEPSEEK

# ============================================================

# Required when LLM_PROVIDER=deepseek

# DEEPSEEK_API_KEY=

DEEPSEEK_MODEL=deepseek-chat

# ============================================================

# MODEL / GENERATION SETTINGS

# ============================================================

# Optional. Controls sampling temperature.

LLM_TEMPERATURE=0.2

# Optional. Route expensive calls such as final QA

# to another provider.

# Example: HEAVY_CALL_PROVIDER=openrouter

HEAVY_CALL_PROVIDER=

# ============================================================

# CHAPTER GENERATION

# ============================================================

# Number of chapters that may be generated concurrently.

# Keep this at 1 unless your provider has enough quota.

MAX_CONCURRENT_CHAPTERS=1

# Number of retries for failed/refused chapter generations.

MAX_CHAPTER_RETRIES=2

# ============================================================

# API RETRIES / TIMEOUTS

# ============================================================

# Number of retries for transient API failures.

MAX_API_RETRIES=5

# Base delay between API retries.

API_RETRY_BASE_DELAY=2.0

# Maximum time to wait automatically for a provider quota.

MAX_AUTO_RETRY_WAIT_SECONDS=90

# HTTP timeout for compatible chat-completions providers.

HTTP_TIMEOUT_SECONDS=180

# ============================================================

# QUALITY ASSURANCE

# ============================================================

# Number of characters from each chapter sent to final QA.

FINAL_QA_EXCERPT_CHARS=1000

# Optional second LLM pass for chapter enhancement.

# 0 = disabled

# 1 = enabled

#

# Enabling this increases chapter LLM calls.

ENABLE_CHAPTER_ENHANCE=0

# Optional LLM verification when a term appears to be redefined.

# 0 = disabled

# 1 = enabled

ENABLE_CONFLICT_CHECK=0

# ============================================================

# DEVELOPMENT / TESTING

# ============================================================

# Set to 1 or true to run without real LLM calls or pdflatex.

# DRY_RUN=1
