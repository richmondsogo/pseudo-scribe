# .env.example - Environment configuration for Pseudo-Scribe
# Copy to .env and customize as needed.

# ============================================================
# LLM PROVIDER SELECTION
# ============================================================
# Provider to use for pipeline LLM calls.
# Choices: gemini | groq | openrouter | deepseek
LLM_PROVIDER=gemini

# ============================================================
# GOOGLE GEMINI (Default Provider)
# ============================================================
# Required when LLM_PROVIDER=gemini (also accepts GOOGLE_API_KEY)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ============================================================
# GROQ
# ============================================================
# Required when LLM_PROVIDER=groq
# GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================================
# OPENROUTER
# ============================================================
# Required when LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://github.com/richmondsogo/Pseudo-Scribe
OPENROUTER_SITE_NAME=Pseudo-Scribe

# ============================================================
# DEEPSEEK
# ============================================================
# Required when LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# MODEL / GENERATION PARAMETERS
# ============================================================
# Sampling temperature for creative vs deterministic generation
LLM_TEMPERATURE=0.2

# Optional provider override for heavy calls (final QA, typesetter fallback).
# Example: HEAVY_CALL_PROVIDER=openrouter
# HEAVY_CALL_PROVIDER=

# ============================================================
# CHAPTER GENERATION & CONCURRENCY
# ============================================================
# Number of chapters generated concurrently (keep at 1 on free tiers)
MAX_CONCURRENT_CHAPTERS=1

# Retries for failed or refused chapter drafts before failing
MAX_CHAPTER_RETRIES=2

# ============================================================
# API RETRIES & TIMEOUTS
# ============================================================
# Number of retry attempts on transient network or rate-limit errors
MAX_API_RETRIES=5

# Base backoff delay in seconds for exponential retries
API_RETRY_BASE_DELAY=2.0

# Maximum wait time in seconds to honor Retry-After headers automatically
MAX_AUTO_RETRY_WAIT_SECONDS=90

# HTTP request timeout in seconds for compatible chat completions
HTTP_TIMEOUT_SECONDS=180

# ============================================================
# QUALITY ASSURANCE & TERMINOLOGY
# ============================================================
# Character limit per chapter excerpt sent to final course QA
FINAL_QA_EXCERPT_CHARS=1000

# Optional second LLM pass to improve LaTeX styling and add diagrams (0=off, 1=on)
ENABLE_CHAPTER_ENHANCE=0

# Optional LLM check to verify if re-declared terms conflict with prior definitions (0=off, 1=on)
ENABLE_CONFLICT_CHECK=0

# ============================================================
# DEVELOPMENT / TESTING
# ============================================================
# Mock all LLM calls and pdflatex compilation for offline testing (0=off, 1=on)
# DRY_RUN=1
